DATABASE_URL=
OWNER_USER_ID=
SESSION_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Feature flags
# CURRICULUM_IMPORT_LEGACY_PROMPT=true                    # Use legacy v1 curriculum import prompt (v2 with entity-name fields is default)
# CURRICULUM_IMPORT_DAILY_LIMIT=10  # Max curriculum imports per day per user. Use 0 on staging/testing to disable.
# CURRICULUM_IMPORT_LINKING=true                          # Enable entity linking during curriculum import for all users (exact name match, same-batch-first, no fuzzy matching)
# CURRICULUM_IMPORT_LINKING_ADMIN_CANARY=true             # Enable entity linking only for admin users (ignored if CURRICULUM_IMPORT_LINKING=true)

# Google Drive Picker (optional)
# Create a Web application OAuth client in Google Cloud.
# Add every app origin under Authorized JavaScript origins, for example:
# http://localhost:3000,https://your-app.vercel.app
GOOGLE_CLIENT_ID=
# Optional if your OAuth client id starts with "<project-number>-".
# Otherwise set this to the Google Cloud project number.
GOOGLE_APP_ID=
GOOGLE_API_KEY=
# Optional app-side allowlist. Google Cloud Authorized JavaScript origins is still required.
GOOGLE_AUTHORIZED_ORIGINS=http://localhost:3000

# Vercel Cron authentication for retrying pending approval notifications
CRON_SECRET=
