DATABASE_URL=
OWNER_EMAIL=your@email.com
SESSION_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Drive Picker (optional)
# Create a Web application OAuth client in Google Cloud.
# Add every app origin under Authorized JavaScript origins, for example:
# http://localhost:3000,https://your-app.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional if your OAuth client id starts with "<project-number>-".
# Otherwise set this to the Google Cloud project number.
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_AUTHORIZED_ORIGINS=http://localhost:3000
